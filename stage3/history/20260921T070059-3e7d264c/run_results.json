ation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-21T07:00:59.126106Z", "completed_at": "2026-09-21T07:00:59.133737Z"}, {"name": "execute", "started_at": "2026-09-21T07:00:59.134014Z", "completed_at": "2026-09-21T07:00:59.138264Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.014096260070800781, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_duckdb_lab.relationships_stg_salesforce_orders_customer_id__customer_id__ref_stg_customers_.0c00ea87ca", "compiled": true, "compiled_code": "\n    \n    \n\nwith child as (\n    select customer_id as from_field\n    from \"analytics\".\"s2_dev\".\"stg_salesforce_orders\"\n    where customer_id is not null\n),\n\nparent as (\n    select customer_id as to_field\n    from \"analytics\".\"s2_dev\".\"stg_customers\"\n)\n\nselect\n    from_field\n\nfrom child\nleft join parent\n    on child.from_field = parent.to_field\n\nwhere parent.to_field is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-21T07:00:59.131491Z", "completed_at": "2026-09-21T07:00:59.133879Z"}, {"name": "execute", "started_at": "2026-09-21T07:00:59.134589Z", "completed_at": "2026-09-21T07:00:59.139029Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.014129161834716797, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_duckdb_lab.unique_stg_salesforce_orders_order_id.38fc09a253", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    order_id as unique_field,\n    count(*) as n_records\n\nfrom \"analytics\".\"s2_dev\".\"stg_salesforce_orders\"\nwhere order_id is not null\ngroup by order_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "start