xercise 3.\nselect o.*, f.rate_to_usd, o.amount * f.rate_to_usd as amount_usd\nfrom \"analytics\".\"s2_dev\".\"int_orders\" o\njoin \"analytics\".\"raw\".\"fx_rates\" f\n  on f.currency = o.currency and f.rate_date = cast(o.created_at as date)", "relation_name": "\"analytics\".\"s2_dev\".\"int_orders_fx\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-21T07:00:59.209760Z", "completed_at": "2026-09-21T07:00:59.210544Z"}, {"name": "execute", "started_at": "2026-09-21T07:00:59.210668Z", "completed_at": "2026-09-21T07:00:59.220222Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.010894060134887695, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.dbt_duckdb_lab.daily_revenue", "compiled": true, "compiled_code": "-- reads: \"analytics\".\"s2_dev\".\"int_orders_fx\"\n-- breaks if: 05 did not run\nselect cast(created_at as date) as revenue_date, source_system,\n       count(*) as order_count, sum(amount_usd) as revenue_usd\nfrom \"analytics\".\"s2_dev\".\"int_orders_fx\"\ngroup by 1, 2", "relation_name": "\"analytics\".\"s2_dev\".\"daily_revenue\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-21T07:00:59.221535Z", "completed_at": "2026-09-21T07:00:59.222195Z"}, {"name": "execute", "started_at": "2026-09-21T07:00:59.222317Z", "completed_at": "2026-09-21T07:00:59.225489Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.0045528411865234375, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_duckdb_lab.assert_parity", "compiled": true, "compiled_code": "-- Both pipelines must agree on clean data. If this fails, one of them has a\n-- bug, and finding out which is a better lesson than either working first time.\nwith a as (select revenue_date, source_system, order_count,\n                  round(revenue_usd,2) as revenue_usd from s1.daily_revenue),\n     b as (select revenue_date, source_system, order_count,\n                  round(revenue_usd,2) as revenue_usd from \"analytics\".\"s2_dev\".\"daily_revenue\")\nselect 's1_only' as side, * from (select * from a except select * from b)\nunion all\nselect 's2_only' as side, * from (select * from b except select * from a)", "relation_name": null, "batch_results": null, "overload_results": null}], "elapsed_time": 0.23726701736450195, "args": {"validate_macro_args": true, "allow_jinja_file_extensions": false, "log_format": "default", "populate_cache": true, "log_path": "/Users/bswamy/github.com/bharathts07/dbt-duckdb-lab/stage2_dbt/logs", "log_level_file": "debug", "require_batched_execution_for_custom_microbatch_strategy": true, "latest_version_pointer_enabled_by_default": false, "use_fast_test_edges": false, "introspect": true, "require_unique_project_resource_names": false, "exclude_resource_types": [], "defer": false, "exclude": [], "invocation_command": "dbt build", "require_sql_header_in_test_configs": false, "strict_mode": false, "vars": {}, "use_colors": true, "profiles_dir": ".", "project_dir": "/Users/bswamy/github.com/bharathts07/dbt-duckdb-lab/stage2_dbt", "partial_parse": true, "include_saved_query": false, "which": "build", "use_v2_parser": false, "require_source_and_semantic_model_names_without_spaces": false, "warn_error_options": {"error": [], "warn": [], "silence": []}, "log_file_max_bytes": 10485760, "require_ref_searches_node_package_before_root": false, "macro_debugging": false, "empty": false, "version_check": true, "log_format_file": "debug", "require_explicit_package_overrides_for_builtin_materializations": true, "source_freshness_run_project_hooks": true, "state_modified_compare_vars": false, "write_json": true, "printer_width": 80, "use_catalogs_v2": false, "enable_grouped_warn_error_parser_logs": false, "require_nested_cumulative_type_params": true, "export_saved_queries": false, "resource_types": [], "re