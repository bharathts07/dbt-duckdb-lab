rcise 4.\nselect o.*, f.rate_to_usd, o.amount * f.rate_to_usd as amount_usd\nfrom \"analytics\".\"s2_dev\".\"int_orders\" o\njoin \"analytics\".\"raw\".\"fx_rates\" f\n  on f.currency = o.currency and f.rate_date = cast(o.created_at as date)", "relation_name": "\"analytics\".\"s2_dev\".\"int_orders_fx\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-21T07:30:37.640230Z", "completed_at": "2026-09-21T07:30:37.640997Z"}, {"name": "execute", "started_at": "2026-09-21T07:30:37.641117Z", "completed_at": "2026-09-21T07:30:37.649908Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.010091066360473633, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.dbt_duckdb_lab.daily_revenue", "compiled": true, "compiled_code": "-- reads: \"analytics\".\"s2_dev\".\"int_orders_fx\"\n-- breaks if: 05 did not run\nselect cast(created_at as date) as revenue_date, source_system,\n       count(*) as order_count, sum(amount_usd) as revenue_usd\nfrom \"analytics\".\"s2_dev\".\"int_orders_fx\"\ngroup by 1, 2", "relation_name": "\"analytics\".\"s2_dev\".\"daily_revenue\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-21T07:30:37.651240Z", "completed_at": "2026-09-21T07:30:37.651863Z"}, {"name": "execute", "started_at": "2026-09-21T07:30:37.651988Z", "completed_at": "2026-09-21T07:30:37.654806Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.004170894622802734, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_duckdb_lab.assert_parity", "compiled": true, "compiled_code": "-- Both pipelines must agree on clean data. If this fails, one of them has a\n-- bug, and finding out which is a better lesson than either working first time.\nwith a as (select revenue_date, source_system, order_count,\n                  round(revenue_usd,2) as reve