cise 3.\nselect o.*, f.rate_to_usd, o.amount * f.rate_to_usd as amount_usd\nfrom \"analytics\".\"s2_dev\".\"int_orders\" o\njoin \"analytics\".\"raw\".\"fx_rates\" f\n  on f.currency = o.currency and f.rate_date = cast(o.created_at as date)", "relation_name": "\"analytics\".\"s2_dev\".\"int_orders_fx\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-21T07:05:11.222689Z", "completed_at": "2026-09-21T07:05:11.223427Z"}, {"name": "execute", "started_at": "2026-09-21T07:05:11.223549Z", "completed_at": "2026-09-21T07:05:11.233416Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.011140823364257812, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.dbt_duckdb_lab.daily_revenue", "compiled": true, "compiled_code": "-- reads: \"analytics\".\"s2_dev\".\"int_orders_fx\"\n-- breaks if: 05 did not run\nselect cast(created_at as date) as revenue_date, source_system,\n       count(*) as order_count, sum(amount_usd) as revenue_usd\nfrom \"analytics\".\"s2_dev\".\"int_orders_fx\"\ngroup by 1, 2", "relation_name": "\"analytics\".\"s2_dev\".\"daily_revenue\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-21T07:05:11.234750Z", "completed_at": "2026-09-21T07:05:11.235462Z"}, {"name": "execute", "started_at": "2026-09-21T07:05:11.235587Z", "completed_at": "2026-09-21T07:05:11.238859Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0047070980072021484, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_duckdb_lab.assert_parity", "compiled": true, "compiled_code": "-- Both pipelines must agree on clean data. If this fails, one of them has a\n-- bug, and finding out which is a better lesson than either working first time.\nwith a as (select revenue_date, source_system, order_count,\n                  round(revenue_usd,2) as reve