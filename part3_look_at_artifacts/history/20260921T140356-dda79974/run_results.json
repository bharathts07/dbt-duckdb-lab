p by customer_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-21T14:03:56.367669Z", "completed_at": "2026-09-21T14:03:56.368661Z"}, {"name": "execute", "started_at": "2026-09-21T14:03:56.368786Z", "completed_at": "2026-09-21T14:03:56.404612Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.03737378120422363, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.dbt_duckdb_lab.all_orders_combined", "compiled": true, "compiled_code": "-- reads: \"analytics\".\"built_by_dbt_dev\".\"cleaned_salesforce_orders\", \"analytics\".\"built_by_dbt_dev\".\"cleaned_shopify_orders\", \"analytics\".\"built_by_dbt_dev\".\"cleaned_customers\"\n-- breaks if: 01, 02 or 03 did not run. You get \"Table does not exist\" and it\n--            does not tell you which of the three is missing.\nselect 'salesforce' as source_system, cast(order_id as varchar) as order_key,\n       customer_id, amount, currency, created_at\nfrom \"analytics\".\"built_by_dbt_dev\".\"cleaned_salesforce_orders\"\nunion all\nselect 'shopify' as source_system, s.order_key, c.customer_id,\n       s.amount, s.currency, s.created_at\nfrom \"analytics\".\"built_by_dbt_dev\".\"cleaned_shopify_orders\" s\nleft join \"analytics\".\"built_by_dbt_dev\".\"cleaned_customers\" c on c.email = s.email", "relation_name": "\"analytics\".\"built_by_dbt_dev\".\"all_orders_combined\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-21T14:03:56.406180Z", "completed_at": "2026-09-21T14:03:56.407247Z"}, {"name": "execute", "started_at": "2026-09-21T14:03:56.407393Z", "completed_at": "2026-09-21T14:03:56.434433Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.028768062591552734, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.dbt_duckdb_lab.orders_converted_to_usd", "compiled": true, "compiled_code": "-- reads: \"analytics\".\"built_by_dbt_dev\".\"all_orders_combined\", \"analytics\".\"raw\".\"currency_exchange_rates\"\n-- breaks if: 04 did not run. ALSO silently drops any row whose currency does\n--            not match a rate. Nothing warns. That is exercise 4.\nselect o.*, f.rate_to_usd, o.amount * f.rate_to_usd as amount_usd\nfrom \"analytics\".\"built_by_dbt_dev\".\"all_orders_combined\" o\njoin \"analytics\".\"raw\".\"currency_exchange_rates\" f\n  on f.currency = o.currency and f.rate_date = cast(o.created_at as date)", "relation_name": "\"analytics\".\"built_by_dbt_dev\".\"orders_converted_to_usd\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-21T14:03:56.436248Z", "completed_at": "2026-09-21T14:03:56.437251Z"}, {"name": "execute", "started_at": "2026-09-21T14:03:56.437391Z", "completed_at": "2026-09-21T14:03:56.448141Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.012388229370117188, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.dbt_duckdb_lab.revenue_per_day", "compiled": true, "compiled_code": "-- reads: \"analytics\".\"built_by_dbt_dev\".\"orders_converted_to_usd\"\n-- breaks if: 05 did not run\nselect cast(created_at as date) as revenue_date, source_system,\n       count(*) as order_count, sum(amount_usd) as revenue_usd\nfrom \"analytics\".\"built_by_dbt_dev\".\"orders_converted_to_usd\"\ngroup by 1, 2", "relation_name": "\"analytics\".\"built_by_dbt_dev\".\"revenue_per_day\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-21T14:03:56.449604Z", "completed_at": "2026-09-21T14:03:56.450463Z"}, {"name": "execute", "started_at": "2026-09-21T14:03:56.450587Z", "completed_at": "2026-09-21T14:03:56.453264Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.004279613494873047, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.dbt_duckdb_lab.assert_parity", "compiled": true, "compiled_code": "-- Both pipelines must agree on clean data. If this fails, one of them has a\n-- bug, and finding out which is a better lesson than either working first time.\nwith a as (select revenue_date, source_system, order_count,\n                  round(revenue_usd,2) as revenue_usd from built_by_hand.revenue_per_day),\n     b as (select revenue_date, source_system, order_count,\n                  round(revenue_usd,2) as revenue_usd from \"analytics\".\"built_by_dbt_dev\".\"revenue_per_day\")\nselect 'part1_only' as side, * from (select * from a except select * from b)\nunion all\nselect 'part2_only' as side, * from (select * from b except select * from a)", "relation_name": null, "batch_results": null, "overload_results": null}], "elapsed_time": 0.2359938621520996, "args": {"log_format": "default", "quiet": false, "use_fast_test_edges": false, "include_saved_query": false, "strict_mode": false, "require_batched_execution_for_custom_microbatch_strategy": true, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "use_catalogs_v2": false, "require_nested_cumulative_type_params": true, "empty": false, "vars": {}, "state_modified_compare_vars": false, "invocation_command": "dbt build", "upload_to_artifacts_ingest_api": false, "introspect": true, "require_yaml_configuration_for_mf_time_spines": true, "require_ref_searches_node_package_before_root": false, "log_file_max_bytes": 10485760, "require_source_and_semantic_model_names_without_spaces": false, "cache_selected_only": false, "source_freshness_run_project_hooks": true, "partial_parse": true, "show": false, "macro_debugging": false, "project_dir": "/Users/bswamy/github.com/bharathts07/dbt-duckdb-lab/part2_with_dbt", "require_resource_names_without_spaces": true, "state_modified_compare_more_unrendered_values": true, "latest_version_poi